</clause>

<clause id="_9dmelement_dislocationtype_xml" obligation="normative">
<title>9)　DmElement_dislocationType.xml</title>
<table id="_b9009f9f-ffd7-53a8-ba6a-6b24bb85b887"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
