<clause id="_12urfpromotiondistrict" obligation="normative">
<title>12)　urf:PromotionDistrict</title>
<table id="_b04d1b7e-d8e0-c286-1f3d-6ba4f4880717"><colgroup><col width="25%"/><col width="25%"/><col width="50%"/></colgroup><thead><tr><th valign="top" align="left">型の定義</th>
