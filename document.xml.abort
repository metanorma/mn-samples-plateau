<path class="st12_inject_51" d="M367.5,154.9c1.2,0,2.2,1,2.2,2.2l0,0v9.5l0,0c0,1.2-1,2.2-2.2,2.2l0,0l0,0H358l0,0c-1.2,0-2.2-1-2.2-2.2l0,0  v-9.5c0-1.2,1-2.2,2.2-2.2l0,0H367.5L367.5,154.9L367.5,154.9z"/>
<text transform="matrix(0.85 0 0 1 374.8442 166.2036)" class="st13_inject_51 st14_inject_51 st15_inject_51">CityGMLに定義されたクラス</text>
<path class="st6_inject_51" d="M367.5,171.4c1.2,0,2.2,1,2.2,2.2l0,0v9.5l0,0c0,1.2-1,2.2-2.2,2.2l0,0l0,0H358l0,0c-1.2,0-2.2-1-2.2-2.2l0,0  v-9.5c0-1.2,1-2.2,2.2-2.2l0,0H367.5L367.5,171.4L367.5,171.4z"/>
