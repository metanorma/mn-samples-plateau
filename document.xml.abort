<table id="_55ee884f-58a0-f256-30b0-6d27e5efdd25"><colgroup><col width="14.2857%"/><col width="85.7143%"/></colgroup><thead><tr><th valign="top" align="left">No</th>
<th valign="top" align="left">L17</th>
</tr></thead>
<tbody><tr><th valign="top" align="left">品質要素</th>
<th valign="top" align="left">論理一貫性・位相一貫性</th>
</tr><tr><th valign="top" align="left">品質適用範囲</th>
