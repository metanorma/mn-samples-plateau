<clause id="_3common_districtandzonestype_xml" obligation="normative">
<title>3)　Common_districtAndZonesType.xml</title>
<table id="_5374f304-8b15-32bf-c374-f1269fcea823"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
<th valign="top" align="left">Common_districtsAndZonesType.xml</th>
</tr></thead>
<tbody><tr><td valign="top" align="left">ファイルURL</td>
<td valign="top" align="left"><link target="https://www.geospatial.jp/iur/codelists/3.1/Common_districtsAndZonesType.xml"/></td>
</tr><tr><td valign="top" align="left">コード</td>
<td valign="top" align="left">説明</td>
</tr><tr><td valign="top" align="left">0</td>
<td valign="top" align="left">用途地域の指定をしない区域</td>
</tr><tr><td valign="top" align="left">1</td>
