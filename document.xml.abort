<text transform="matrix(0.85 0 0 1 257.3691406 134.5126953)" class="st2_inject_16 st3_inject_16">«FeatureType»</text>
<text transform="matrix(0.85 0 0 1 248.7363281 143.2548828)" class="st4_inject_16 st3_inject_16">tran::TrafficComplex</text>
<line class="st1_inject_16" x1="227.915863" y1="147.37146" x2="329.9985962" y2="147.37146"/>
<text transform="matrix(0.85 0 0 1 230.4472656 156.6220703)" class="st2_inject_16 st3_inject_16">+</text>
<text transform="matrix(0.85 0 0 1 235.0166016 156.6220703)" class="st2_inject_16 st3_inject_16"> </text>
<text transform="matrix(0.85 0 0 1 241.6269531 156.6220703)" class="st2_inject_16 st3_inject_16">class: gml::CodeType [0..1]</text>
<text transform="matrix(0.85 0 0 1 230.4472656 165.3720703)" class="st2_inject_16 st3_inject_16">+</text>
<text transform="matrix(0.85 0 0 1 235.0166016 165.3720703)" class="st2_inject_16 st3_inject_16"> </text>
