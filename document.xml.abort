	.st8_inject_62 {fill-rule:evenodd;clip-rule:evenodd;fill:#F0F0F0;}
	.st9_inject_62 {fill:none;stroke:#D7D7D7;stroke-width:0.8662;stroke-linecap:square;stroke-miterlimit:10;}
	.st10_inject_62 {fill-rule:evenodd;clip-rule:evenodd;fill:#CCFFCC;}
	.st11_inject_62 {fill:none;stroke:#000000;stroke-width:0.8662;stroke-linecap:square;stroke-miterlimit:10;}
	.st12_inject_62 {fill:#003060;}
	.st13_inject_62 {fill-rule:evenodd;clip-rule:evenodd;fill:#FFCCFF;}
	.st14_inject_62 {font-family:'MS-PGothic';}
	.st15_inject_62 {font-size:13.8582px;}
