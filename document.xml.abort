<text transform="matrix(0.85 0 0 1 486.4023438 439.0618896)" class="st2_inject_50 st4_inject_50">+thematicShape</text>
<text transform="matrix(0.85 0 0 1 516.8789062 456.0384521)" class="st2_inject_50 st4_inject_50">0..*</text>
