</clause>

<clause id="_1appearance_mimetype_xml" obligation="normative">
<title>1)　Appearance_mimeType.xml</title>
<table id="_546759ba-c7bc-7bff-cf6c-642d833acb9c"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
