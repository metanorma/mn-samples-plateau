<td valign="top" align="left"/></tr><tr><td valign="top" align="left">lod4MultiSurface</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="center">■</td>
</tr><tr><td valign="top" rowspan="4" align="left">bldg:OuterFloorSurface</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="center">〇</td>
<td valign="top" align="center">〇</td>
<td valign="top" align="center">〇</td>
<td valign="top" align="left">屋根面のうち、通行可能な面を明示するために使用できる。</td>
</tr><tr><td valign="top" align="left">lod2MultiSurface</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="center">■</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" rowspan="3" align="left">bldg:OuterFloorSurfaceを作る場合は必須とする。</td>
</tr><tr><td valign="top" align="left">lod3MultiSurface</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="center">■</td>
<td valign="top" align="left"/></tr><tr><td valign="top" align="left">lod4MultiSurface</td>
<td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="left"/><td valign="top" align="center">■</td>
</tr><tr><td valign="top" rowspan="4" align="left">bldg:ClosureSurface</td>
