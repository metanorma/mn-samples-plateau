<clause id="_18uroifcpsetopeningelementcommon" obligation="normative">
<title>18)　uro:IfcPsetOpeningElementCommon</title>
<table id="_10fdb02b-f427-50fe-1572-9b2e479e10f6"><colgroup><col width="25%"/><col width="25%"/><col width="50%"/></colgroup><thead><tr><th valign="top" align="left">型の定義</th>
