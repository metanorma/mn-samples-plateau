</clause>

<clause id="_2texturetypetype" obligation="normative">
<title>2)　TextureTypeType</title>
<table id="_88b44cdb-115a-574f-bc8a-aa8e8691af89"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">列挙型</th>
<th valign="top" align="left">TextureTypeType</th>
</tr></thead>
<tbody><tr><td valign="top" align="left">値</td>
<td valign="top" align="left">説明</td>
</tr><tr><td valign="top" align="left">specific</td>
