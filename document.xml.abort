<clause id="_1dataqualityattribute_geometrysrcdesc_xml" obligation="normative">
<title>1)　DataQualityAttribute_geometrySrcDesc.xml</title>
<table id="_47cfdff4-7231-8633-ebb4-068ea038a0e5"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
<th valign="top" align="left">DataQualityAttribute_geometrySrcDesc.xml</th>
</tr></thead>
<tbody><tr><td valign="top" align="left">ファイルURL</td>
<td valign="top" align="left"><link target="https://www.geospatial.jp/iur/codelists/3.1/DataQualityAttribute_geometrySrcDesc.xml"/></td>
</tr><tr><td valign="top" align="left">コード</td>
<td valign="top" align="left">説明</td>
</tr><tr><td valign="top" align="left">000</td>
<td valign="top" align="left">公共測量成果</td>
</tr><tr><td valign="top" align="left">101</td>
<td valign="top" align="left">（公共測量ではない）現地測量の測量成果</td>
</tr><tr><td valign="top" align="left">102</td>
<td valign="top" align="left">（公共測量ではない）UAV写真測量の測量成果</td>
</tr><tr><td valign="top" align="left">103</td>
<td valign="top" align="left">（公共測量ではない）空中写真測量の測量成果</td>
</tr><tr><td valign="top" align="left">104</td>
