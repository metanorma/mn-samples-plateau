<clause id="_5urfdisasterpreventionblockimprovementzoneplan" obligation="normative">
<title>5)　urf:DisasterPreventionBlockImprovementZonePlan</title>
<table id="_046345f4-f491-4c05-cfe3-d78f47f840ba"><colgroup><col width="25%"/><col width="25%"/><col width="50%"/></colgroup><thead><tr><th valign="top" align="left">型の定義</th>
