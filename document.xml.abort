<clause id="_3road_usage_xml" obligation="normative">
<title>3)　Road_usage.xml</title>
<table id="_1d092b46-10a8-f0ba-c046-b4252554ea28"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
