</tr><tr><td valign="top" align="left">(uro:capacityByWeight)</td>
<td valign="top" align="left">gml:MeasureType [0..1]</td>
<td valign="top" align="left">許容積載量。</td>
</tr><tr><td valign="top" align="left">(uro:capacityByNumber)</td>
<td valign="top" align="left">xs:integer [0..1]</td>
