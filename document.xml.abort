</clause>

<clause id="_1transportationcomlex_class_xml" obligation="normative">
<title>1)　TransportationComlex_class.xml</title>
<p id="_201612e0-6db3-6e43-a335-f7ada33d8b60">tran:Roadのコードリスト参照</p>

<p id="_2b38c802-a62b-e3a8-f688-2ecddc5634b2">　</p>
</clause>

<clause id="_2railway_function_xml" obligation="normative">
<title>2)　Railway_function.xml</title>
<table id="_810cd565-7146-66ac-5dd3-2842cef4179f"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
<th valign="top" align="left">Railway_function.xml</th>
</tr></thead>
<tbody><tr><td valign="top" align="left">ファイルURL</td>
<td valign="top" align="left"><link target="https://www.geospatial.jp/iur/codelists/3.1/Railway_function.xml"/></td>
</tr><tr><td valign="top" align="left">コード</td>
<td valign="top" align="center">説明</td>
</tr><tr><td valign="top" align="left">01</td>
<td valign="top" align="left">普通鉄道</td>
</tr><tr><td valign="top" align="left">02</td>
<td valign="top" align="left">地下鉄</td>
</tr><tr><td valign="top" align="left">03</td>
<td valign="top" align="left">路面鉄道</td>
</tr><tr><td valign="top" align="left">04</td>
