<clause id="_1_dataqualityattribute_geometrysrcdesc_xml" obligation="normative">
<title>1) DataQualityAttribute_geometrySrcDesc.xml</title>
<table id="_b2d8c4bc-c702-9114-d7b0-8c4e4154dfe5"><colgroup><col width="12%"/><col width="88%"/></colgroup><thead><tr><th valign="top" align="left">ファイル名</th>
