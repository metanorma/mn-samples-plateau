<text transform="matrix(0.85 0 0 1 230.4472656 174.1142578)" class="st2_inject_16 st3_inject_16">+</text>
<text transform="matrix(0.85 0 0 1 235.0166016 174.1142578)" class="st2_inject_16 st3_inject_16"> </text>
